<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FF1E1E1E">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="#FF242424"
        android:elevation="2dp">

        <TextView
            android:id="@+id/groupEditBack"
            android:layout_width="56dp"
            android:layout_height="match_parent"
            android:text="‹"
            android:textColor="#FFFFFFFF"
            android:textSize="28sp"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless" />

        <TextView
            android:id="@+id/groupEditTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Редактирование"
            android:textColor="#FFFFFFFF"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/groupEditSave"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:text="СОХРАНИТЬ"
            android:textColor="#FFFF6F00"
            android:textSize="13sp"
            android:textStyle="bold"
            android:paddingHorizontal="16dp"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackground" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="НАЗВАНИЕ"
                android:textColor="#FF888888"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.08"
                android:layout_marginBottom="6dp" />

            <EditText
                android:id="@+id/groupEditName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#FF2A2A2A"
                android:padding="12dp"
                android:textColor="#FFFFFFFF"
                android:textColorHint="#FF666666"
                android:hint="Например, Ралли"
                android:textSize="15sp"
                android:maxLength="32"
                android:inputType="text"
                android:imeOptions="actionDone" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ЦВЕТ"
                android:textColor="#FF888888"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.08"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="8dp" />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/groupEditColorsRow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />
            </HorizontalScrollView>

            <TextView
                android:id="@+id/groupEditMembersCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#FF888888"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.08"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="8dp"
                android:text="УЧАСТНИКИ" />

            <LinearLayout
                android:id="@+id/groupEditMembers"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <TextView
                android:id="@+id/groupEditAddMembers"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:padding="14dp"
                android:text="+ ДОБАВИТЬ УЧАСТНИКОВ"
                android:textColor="#FFFF6F00"
                android:textSize="13sp"
                android:textStyle="bold"
                android:gravity="center"
                android:background="#331E3A5E"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/groupEditDelete"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:padding="14dp"
                android:text="УДАЛИТЬ ГРУППУ"
                android:textColor="#FFF44336"
                android:textSize="13sp"
                android:textStyle="bold"
                android:gravity="center"
                android:background="#332B1212"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
