<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FF1E1E1E">

    <!-- Top bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="#FF242424"
        android:elevation="2dp">

        <TextView
            android:id="@+id/favGroupsBack"
            android:layout_width="56dp"
            android:layout_height="match_parent"
            android:text="‹"
            android:textColor="#FFFFFFFF"
            android:textSize="28sp"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Группы мониторинга"
            android:textColor="#FFFFFFFF"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/favGroupsAddBtn"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:text="+ НОВАЯ"
            android:textColor="#FFFF6F00"
            android:textSize="13sp"
            android:textStyle="bold"
            android:paddingHorizontal="16dp"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackground" />
    </LinearLayout>

    <TextView
        android:id="@+id/favGroupsNoSyncHint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="12dp"
        android:text="Синхронизация появится после привязки email в Настройках → Облачная синхронизация"
        android:textColor="#FFAA8800"
        android:textSize="12sp"
        android:background="#FF2A2418"
        android:visibility="gone" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="8dp">

            <TextView
                android:id="@+id/favGroupsEmptyHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="32dp"
                android:text="У вас ещё нет групп. Нажмите «+ НОВАЯ» чтобы создать первую — и добавить туда участников мониторинга, которых хотите видеть на карте."
                android:textColor="#FF888888"
                android:textSize="14sp"
                android:gravity="center"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/favGroupsList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
